{
  "manifest_version": 3,
  "name": "DS2 Tab Audio Recorder MVP",
  "description": "Capture the active tab audio and stream PCM to the DS2 runtime plugin.",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://music.163.com/*",
    "https://*.music.163.com/*",
    "https://open.spotify.com/*",
    "https://*.spotify.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://*.spotify.com/*"
      ],
      "js": [
        "page_control.js",
        "adapters/media_session_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Stream this tab to DS2"
  }
}
