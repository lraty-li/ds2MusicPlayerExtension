{
  "manifest_version": 3,
  "name": "DS2 Tab Audio Recorder MVP",
  "description": "Capture the active tab audio and stream PCM to the DS2 runtime plugin.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "page_control.js",
        "adapters/media_session_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "DS2 audio stream test panel",
    "default_popup": "popup.html"
  }
}
